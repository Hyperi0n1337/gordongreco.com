# Templates only. Do not commit live values.
PORTAL_ENV=production
PORTAL_BASE_URL=https://portal.example.test
PUBLIC_SITE_URL=https://www.example.test
DATABASE_URL=postgresql://portal_api:REPLACE_ME@postgres:5432/portal
SESSION_HMAC_KEY=REPLACE_WITH_32_PLUS_RANDOM_BYTES
CAPABILITY_HMAC_KEY=REPLACE_WITH_32_PLUS_RANDOM_BYTES
INVITATION_HMAC_KEY=REPLACE_WITH_32_PLUS_RANDOM_BYTES
AWS_REGION=us-east-1
KMS_KEY_ID=alias/gg-portal-secrets
QUARANTINE_BUCKET=gg-portal-quarantine
CLEAN_BUCKET=gg-portal-clean
S3_ENDPOINT_URL=
EMAIL_OUTBOX_ONLY=true
TELEGRAM_OUTBOX_ONLY=true
ALLOWED_ORIGINS=https://portal.example.test
MAX_DOCUMENT_BYTES=26214400
MAGIC_COMMAND=/usr/bin/file
CLAMAV_COMMAND=/usr/bin/clamdscan
QPDF_COMMAND=/usr/bin/qpdf
