{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QuarantineMultipartOnly",
      "Effect": "Allow",
      "Action": ["s3:AbortMultipartUpload", "s3:ListMultipartUploadParts", "s3:PutObject"],
      "Resource": "arn:aws:s3:::gg-portal-quarantine/quarantine/*"
    },
    {
      "Sid": "CleanDownloadOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::gg-portal-clean/clean/*"
    },
    {
      "Sid": "TotpEnvelopeEncryption",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "arn:aws:kms:us-east-1:111122223333:key/REPLACE"
    }
  ]
}
