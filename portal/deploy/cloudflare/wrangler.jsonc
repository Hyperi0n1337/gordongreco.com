{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gordon-greco-client-portal",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/portal/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gg-portal",
      "database_id": "984c8e63-dce2-471b-b6e5-bba0812be46b"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DOCUMENTS",
      "id": "dfb39eaa70cc446e8b7d269ead3d4a1d"
    }
  ],
  "vars": {
    "MAX_UPLOAD_BYTES": "20971520",
    "SESSION_SECONDS": "3600"
  }
}
